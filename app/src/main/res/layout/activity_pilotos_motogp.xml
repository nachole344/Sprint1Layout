<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- CABECERA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="35sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="MGP PILOTOS"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- INFORMACION DE TEMPORADA -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="2026 SEASON"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="22 DRIVERS · 11 TEAMS"
            android:textColor="#888888"
            android:textSize="13sp" />

        <!-- Jorge Martin -->

        <LinearLayout
            android:id="@+id/cardJorge"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="25dp"
            android:background="#19191F"
            android:orientation="horizontal"
            android:padding="15dp">

            <!-- FOTO -->

            <ImageView
                android:id="@+id/imgJorge"
                android:layout_width="125dp"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/jorge_martin" />

            <!-- INFORMACION -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <!-- Posición -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#01"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <!-- Nombre y Apellido -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="JORGE"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MARTIN"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Equipo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Aprilia Racing"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <!-- Nacionalidad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="SPAIN"
                    android:textColor="#666666"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Marc Marquez -->

        <LinearLayout
            android:id="@+id/cardMarc"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="25dp"
            android:background="#19191F"
            android:orientation="horizontal"
            android:padding="15dp">

            <!-- FOTO -->

            <ImageView
                android:id="@+id/imgMarc"
                android:layout_width="125dp"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/marc_marquez" />

            <!-- INFORMACION -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <!-- Posición -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#02"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <!-- Nombre y Apellido -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="MARC"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MARQUEZ"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Equipo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Ducati Lenovo Team"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <!-- Nacionalidad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="SPAIN"
                    android:textColor="#666666"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Marco Bezzecchi -->

        <LinearLayout
            android:id="@+id/cardMarco"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="25dp"
            android:background="#19191F"
            android:orientation="horizontal"
            android:padding="15dp">

            <!-- FOTO -->

            <ImageView
                android:id="@+id/imgMarco"
                android:layout_width="125dp"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/marco_bezzecchi" />

            <!-- INFORMACION -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <!-- Posición -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#03"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <!-- Nombre y Apellido -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="MARCO"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEZZECCHI"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Equipo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Aprilia Racing"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <!-- Nacionalidad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="ITALY"
                    android:textColor="#666666"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Pedro Acosta -->

        <LinearLayout
            android:id="@+id/cardPedro"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="25dp"
            android:background="#19191F"
            android:orientation="horizontal"
            android:padding="15dp">

            <!-- FOTO -->

            <ImageView
                android:id="@+id/imgPedro"
                android:layout_width="125dp"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/pedro_acosta" />

            <!-- INFORMACION -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <!-- Posición -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#04"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <!-- Nombre y Apellido -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="PEDRO"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACOSTA"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Equipo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Red Bull KTM Factory Racing"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <!-- Nacionalidad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="SPAIN"
                    android:textColor="#666666"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>