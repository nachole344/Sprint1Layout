<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F"
    android:orientation="vertical">

    <!-- ================================= -->
    <!-- CONTENIDO SCROLLEABLE -->
    <!-- ================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0B0B0F"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B0B0F"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="24dp"
            android:paddingEnd="18dp"
            android:paddingBottom="30dp">

        <!-- ================================= -->
        <!-- CABECERA -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- LOGO -->

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Logo I Show Speed"
                android:scaleType="centerInside"
                android:src="@drawable/ishowspeed_logo" />

            <!-- ESPACIO -->

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- BOTÓN NOTIFICACIONES -->

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/circle_menu">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notificaciones"
                    android:src="@drawable/ic_noti" />

            </FrameLayout>

        </LinearLayout>


        <!-- ================================= -->
        <!-- CARTA PRINCIPAL DEL PILOTO -->
        <!-- ================================= -->

        <FrameLayout
            android:id="@+id/cardPilotoPrincipal"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_home_f1"
            android:clipToOutline="true"
            android:elevation="6dp">

            <!-- FOTO DEL PILOTO -->

            <ImageView
                android:id="@+id/imgPilotoPrincipal"
                android:layout_width="218dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:contentDescription="Max Verstappen"
                android:scaleType="fitEnd"
                android:src="@drawable/max_card_home" />

            <!-- DEGRADADO -->

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_home_f1_gradient" />

            <!-- INFORMACIÓN -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="PILOTO DESTACADO"
                    android:textColor="#BDBDBD"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="MAX"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VERSTAPPEN"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/tag_redbull"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp"
                        android:text="Red Bull Racing  •  #1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>


        <!-- ================================= -->
        <!-- ACCESOS -->
        <!-- ================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:letterSpacing="0.08"
            android:text="EXPLORA F1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="3">


            <!-- PILOTOS -->

            <LinearLayout
                android:id="@+id/menuPilotos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/circle_menu">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:contentDescription="Pilotos"
                        android:src="@drawable/ic_pilotos" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pilotos"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- CLASIFICACIÓN -->

            <LinearLayout
                android:id="@+id/menuClasificacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/circle_menu">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="Clasificación"
                        android:src="@drawable/ic_clasificacion" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Clasificación"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ESTADÍSTICAS -->

            <LinearLayout
                android:id="@+id/menuEstadisticas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/circle_menu">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="Estadísticas"
                        android:src="@drawable/ic_estadisticas" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Estadísticas"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================= -->
        <!-- CALENDARIO -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="PRÓXIMAS CARRERAS"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CALENDARIO"
                android:textColor="#999999"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================ -->
        <!-- CARRERA 1 -->
        <!-- ================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/calendar_item"
            android:clipToOutline="true"
            android:orientation="horizontal">

            <!-- LINEA ROJA INTEGRADA EN LA TARJETA -->
            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/calendar_red_accent" />

            <!-- HORA -->

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OCT"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- SEPARADOR -->

            <View
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:background="#29292F" />


            <!-- INFORMACIÓN -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇺🇸  USA GRAND PRIX"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Austin"
                    android:textColor="#858585"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- HORA -->

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CET"
                    android:textColor="#777777"
                    android:textSize="9sp" />

            </LinearLayout>
            <!-- MENU DE OPCIONES -->

            <TextView
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#888888"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================ -->
        <!-- CARRERA 2 -->
        <!-- ================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/calendar_item"
            android:clipToOutline="true"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/calendar_red_accent" />

            <!-- FECHA -->

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOV"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- SEPARADOR -->

            <View
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:background="#29292F" />

            <!-- INFORMACIÓN -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇲🇽  MEXICO GRAND PRIX"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ciudad de México"
                    android:textColor="#858585"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- HORA -->

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CET"
                    android:textColor="#777777"
                    android:textSize="9sp" />

            </LinearLayout>
            <TextView
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#888888"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================ -->
        <!-- CARRERA 3 -->
        <!-- ================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="@drawable/calendar_item"
            android:clipToOutline="true"
            android:orientation="horizontal">

            <!-- LINEA ROJA -->

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/calendar_red_accent" />

            <!-- FECHA -->

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOV"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- SEPARADOR -->

            <View
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:background="#29292F" />

            <!-- INFORMACIÓN -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇧🇷  SÃO PAULO GRAND PRIX"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Interlagos"
                    android:textColor="#858585"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- HORA -->

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CET"
                    android:textColor="#777777"
                    android:textSize="9sp" />

            </LinearLayout>
            <TextView
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#888888"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>
        </LinearLayout>
    </ScrollView>


    <!-- ================================= -->
    <!-- BARRA FIJA ABAJO -->
    <!-- ================================= -->

    <include
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="70dp" />

</LinearLayout>