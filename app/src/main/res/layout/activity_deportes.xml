<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgLogoDeportes"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/ishowspeed_logo"
                android:contentDescription="Logo I Show Speed"/>

        </LinearLayout>


        <!-- TITULO -->

        <TextView
            android:id="@+id/txtTituloDeportes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ELIGE TU CATEGORIA"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"/>

        <TextView
            android:id="@+id/txtDescripcionDeportes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona tu mundo del motorsport"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="25dp"/>


        <!-- ========================= -->
        <!-- TARJETA F1 -->
        <!-- ========================= -->

        <FrameLayout
            android:id="@+id/cardF1"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/card_deporte"
            android:clickable="true"
            android:focusable="true"
            android:clipToOutline="true">

            <!-- IMAGEN -->

            <ImageView
                android:id="@+id/imgF1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/f1_home"
                android:scaleType="centerCrop"
                android:contentDescription="Formula 1"/>

            <!-- DEGRADADO OSCURO -->

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_gradient"/>

            <!-- CONTENIDO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FORMULA 1"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Velocidad · Circuitos · Pilotos"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- FLECHA -->

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="top|end"
                android:layout_margin="15dp"
                android:gravity="center"
                android:text="→"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:background="@drawable/circle_button"/>

        </FrameLayout>


        <!-- ========================= -->
        <!-- TARJETA MOTOGP -->
        <!-- ========================= -->

        <FrameLayout
            android:id="@+id/cardMotoGP"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/card_deporte"
            android:clickable="true"
            android:focusable="true"
            android:clipToOutline="true">

            <!-- IMAGEN -->

            <ImageView
                android:id="@+id/imgMotoGP"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/motogp_home"
                android:scaleType="centerCrop"
                android:contentDescription="MotoGP"/>

            <!-- DEGRADADO -->

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_gradient"/>

            <!-- CONTENIDO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOTOGP"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adrenalina · Motos · Pilotos"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- FLECHA -->

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="top|end"
                android:layout_margin="15dp"
                android:gravity="center"
                android:text="→"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:background="@drawable/circle_button"/>

        </FrameLayout>

    </LinearLayout>

</ScrollView>

